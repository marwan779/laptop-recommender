# Docker Compose environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by users-service.
# Keep the password in .env / your secret manager only.
USERS_DATABASE_URL=Host=host.docker.internal;Port=5432;Database=users-service-database;Username=postgres;Password=change-me

# JWT signing secret for users-service (at least 32 characters).
# Use a randomly generated value, not the placeholder.
USERS_JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Email / SMTP settings for users-service background price alerts (Hangfire)
USERS_EMAIL_ENABLED=false
USERS_SMTP_HOST=smtp.gmail.com
USERS_SMTP_PORT=587
USERS_SMTP_USE_STARTTLS=true
USERS_SMTP_USERNAME=
USERS_SMTP_PASSWORD=
USERS_EMAIL_FROM=alerts@laptop-recommender.local
USERS_EMAIL_FROM_NAME=Egypt Laptop Recommender
