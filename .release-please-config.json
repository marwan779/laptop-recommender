{
    "separate-pull-requests": true,
    "pull-request-title-pattern": "chore: release ${component} ${version}",
    "pull-request-header": "##  Release PR",
    "pull-request-footer": "Merging this PR will tag the release and deploy to production.",
    "packages": {
        "services/scraper-service": {
            "release-type": "python",
            "package-name": "scraper-service",
            "component": "scraper-service",
            "tag-separator": "-",
            "include-component-in-tag": true,
            "bump-minor-pre-major": true,
            "bump-patch-for-minor-pre-major": true
        },
        "services/catalog-service": {
            "release-type": "python",
            "package-name": "catalog-service",
            "component": "catalog-service",
            "tag-separator": "-",
            "include-component-in-tag": true,
            "bump-minor-pre-major": true,
            "bump-patch-for-minor-pre-major": true
        }
    }
}