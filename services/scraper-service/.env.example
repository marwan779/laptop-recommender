# =============================================================================
# Scraper Service Environment Configuration
# =============================================================================

# Gmail SMTP Settings
# To generate a Gmail App Password:
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. Scroll to the bottom and select "App Passwords"
# 3. Create a new App Password (e.g. Name: "Laptop Scraper")
# 4. Copy the 16-character code into SMTP_PASSWORD below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Laptop Recommender Scraper

# Comma-separated recipient email addresses
REPORT_RECIPIENTS=your_email@gmail.com

# Global toggle to enable/disable email notifications (true/false)
EMAIL_NOTIFICATIONS_ENABLED=true

# Set to true to always write email HTML to 'latest_scraper_report.html' for local testing
EMAIL_PREVIEW_MODE=false

# =============================================================================
# Object Storage (AWS S3 & S3-Compatible)
# =============================================================================
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=laptop-recommender-raw-catalog

# Optional: LocalStack (http://localhost:4566), MinIO (http://localhost:9000), or Cloudflare R2
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true
AWS_S3_FORCE_PATH_STYLE=false