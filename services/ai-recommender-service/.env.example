# =============================================================================
# AI Recommender Service Environment Configuration
# =============================================================================

# Inter-Service Authentication (catalog-service <-> ai-recommender-service)
# Leave empty here and populate manually with the same value used by catalog-service.
AI_RECOMMENDER_API_KEY=
REQUIRE_API_KEY=true

# Object Storage (AWS S3 & S3-Compatible)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=laptop-recommender-raw-catalog
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true
AWS_S3_FORCE_PATH_STYLE=false

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=laptop_events
RABBITMQ_DLX_EXCHANGE_NAME=laptop_events.dlx
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10.0

# Redis Cache Store
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=86400

# Review Enrichment LLM
ENRICHER_LLM_BASE_URL=
ENRICHER_LLM_API_KEY=
