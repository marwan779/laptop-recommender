# =============================================================================
# Catalog Service Environment Configuration (.env.example)
# =============================================================================

# Application & Service Info
SERVICE_NAME=catalog-service
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# PostgreSQL Database (SQLAlchemy 2.0 Async)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/laptop_recommender_catalog
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Unified Logging Subsystem
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# Object Storage (AWS S3 & S3-Compatible)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=laptop-recommender-raw-catalog

# Custom S3 Endpoint (Optional: MinIO http://localhost:9000, LocalStack http://localhost:4566, Cloudflare R2)
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true
AWS_S3_FORCE_PATH_STYLE=false
# Downstream Services
SCRAPER_SERVICE_URL=http://localhost:8001

# Main Laptop Scraping Cron Job (Deep Hardware Discovery)
ENABLE_SCRAPING_CRON=false
SCRAPING_CRON_INTERVAL_HOURS=168
SCRAPING_CRON_LEVEL=2
SCRAPING_CRON_SEND_EMAIL=true

# Price Sync Cron Job (Lightweight Price & Stock Monitor)
ENABLE_PRICE_SYNC_CRON=false
PRICE_SYNC_CRON_INTERVAL_HOURS=24
PRICE_SYNC_BATCH_LIMIT=50
