{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "laptop-recommender-users",
    "Audience": "laptop-recommender-clients",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "laptop_events",
    "DlxExchangeName": "laptop_events.dlx",
    "QueueName": "users.price-alerts.queue",
    "DlqName": "users.price-alerts.dlq",
    "RoutingKey": "laptop.price.changed.event",
    "PrefetchCount": 10
  },
  "Cache": {
    "Enabled": true,
    "RedisConnectionString": "localhost:6379",
    "DefaultTtlSeconds": 3600,
    "ConnectTimeoutMs": 2000,
    "SyncTimeoutMs": 2000,
    "ScanPageSize": 100
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromEmail": "alerts@laptop-recommender.local",
    "FromName": "Egypt Laptop Recommender"
  },
  "Hangfire": {
    "Enabled": true
  }
}
