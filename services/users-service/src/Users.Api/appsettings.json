{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "laptop-recommender-users",
    "Audience": "laptop-recommender-clients",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "laptop_events",
    "DlxExchangeName": "laptop_events.dlx",
    "QueueName": "users.price-alerts.queue",
    "DlqName": "users.price-alerts.dlq",
    "RoutingKey": "laptop.price.changed.event",
    "PrefetchCount": 10
  }
}
