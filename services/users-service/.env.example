# =============================================================================
# Users Service Environment Configuration
# =============================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=users-service-database;Username=postgres;Password=change-me

# JWT Authentication (SecretKey must be at least 32 characters)
Jwt__Issuer=laptop-recommender-users
Jwt__Audience=laptop-recommender-clients
Jwt__SecretKey=change-me-to-a-random-secret-at-least-32-chars
Jwt__AccessTokenExpiryMinutes=30
Jwt__RefreshTokenExpiryDays=7

# RabbitMQ Consumer
RabbitMq__Enabled=true
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__VirtualHost=/
RabbitMq__ExchangeName=laptop_events
RabbitMq__DlxExchangeName=laptop_events.dlx
RabbitMq__QueueName=users.price-alerts.queue
RabbitMq__DlqName=users.price-alerts.dlq
RabbitMq__RoutingKey=laptop.price.changed.event
RabbitMq__PrefetchCount=10

# Redis Response Cache
Cache__Enabled=true
Cache__RedisConnectionString=localhost:6379
Cache__DefaultTtlSeconds=3600

# Email / SMTP Settings (Hangfire Background Delivery)
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__UseStartTls=true
Email__UserName=your_email@gmail.com
Email__Password=your_16_character_app_password
Email__FromEmail=your_email@gmail.com
Email__FromName=Egypt Laptop Recommender

# Hangfire Background Worker
Hangfire__Enabled=true

# Initial Admin Account Seeding
AdminSeed__Enabled=true
AdminSeed__Email=marwanmohamed3337@gmail.com
AdminSeed__FullName=Marwan Mohamed
AdminSeed__Password=change-me-strong-admin-password
